model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  sessions      Session[]
  // Add other fields like 'favorites' later
  password      String // Store the hashed password here
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}