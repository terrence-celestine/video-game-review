generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  reviews   Review[]
}

model Game {
  id        Int      @id // We will use the RAWG ID here
  title     String
  imageUrl  String?
  reviews   Review[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
}